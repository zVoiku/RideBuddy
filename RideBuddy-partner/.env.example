# Copy to .env and edit. Both values are baked in when Metro starts —
# restart with `npx expo start --clear` after changing either one.

# Backend base URL. A phone cannot reach "localhost" — that resolves to the
# phone itself. Use your Mac's LAN IP, and start uvicorn with --host 0.0.0.0.
#   macOS: ipconfig getifaddr en0
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.10:8001

# Google Maps SDK key (iOS). Optional — the app runs without it, but the map
# renders blank. Requires "Maps SDK for iOS" enabled on the key.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
