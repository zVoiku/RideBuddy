# Pages are checked with Cloudflare on every visit (a quick 304 when nothing
# changed), so nobody sees a page older than the site. The scripts and the
# stylesheet they load are asked for by content (build.mjs adds ?v=<hash>), so
# they can be kept a year: a build that changes one gives it a new address.
# Together, a page always arrives with the files built with it.
/
  Cache-Control: no-cache

/estimate/
  Cache-Control: no-cache

/about/
  Cache-Control: no-cache

/contact/
  Cache-Control: no-cache

/privacy/
  Cache-Control: no-cache

/terms/
  Cache-Control: no-cache

/buddy/terms/
  Cache-Control: no-cache

/beta/
  Cache-Control: no-cache

/estimate/app.js
  Cache-Control: public, max-age=31536000, immutable

/shared/pages.js
  Cache-Control: public, max-age=31536000, immutable

/shared/site.css
  Cache-Control: public, max-age=31536000, immutable

/site.js
  Cache-Control: public, max-age=31536000, immutable

# Pictures and the artboard's own files keep their names: a short cache.
/shared/img/*
  Cache-Control: public, max-age=300

/beta/assets/*
  Cache-Control: public, max-age=300

/beta/vendor/*
  Cache-Control: public, max-age=300

/beta/_ds/*
  Cache-Control: public, max-age=300

/beta/support.js
  Cache-Control: public, max-age=300

/beta/rate-config.js
  Cache-Control: public, max-age=300

# The beta is a preview shared by link. Keep it out of search results — a
# "coming soon" artboard is not what should rank for the brand.
/beta/*
  X-Robots-Tag: noindex, nofollow

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
