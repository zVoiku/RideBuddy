{
  // Static-assets-only Worker for ridebuddy.co.in — no server code, just the
  // site built by `npm run build` (which delegates to website/build.mjs).
  //
  // Cloudflare Workers Builds runs from the repository root, so this file and
  // the asset path below are both root-relative. See website/README.md.
  "name": "ridebuddy",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./website/dist"
  }
}
